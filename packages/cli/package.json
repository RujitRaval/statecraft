{
  "name": "@statecraft/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Local initialization, scan orchestration, and report opening for Statecraft.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "statecraft": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.build.json",
    "pretypecheck": "corepack pnpm --filter @statecraft/core build && corepack pnpm --filter @statecraft/runner-playwright build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@statecraft/core": "workspace:*",
    "@statecraft/runner-playwright": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
