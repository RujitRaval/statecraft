{
  "name": "statecraft-ui",
  "version": "0.24.1",
  "description": "Local initialization, scan orchestration, and report opening for Statecraft.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RujitRaval/statecraft.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RujitRaval/statecraft#readme",
  "bugs": {
    "url": "https://github.com/RujitRaval/statecraft/issues"
  },
  "keywords": [
    "cli",
    "playwright",
    "ui-testing",
    "state-coverage"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "statecraft": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.build.json",
    "pretypecheck": "corepack pnpm --filter statecraft-ui-core build && corepack pnpm --filter statecraft-ui-report build && corepack pnpm --filter statecraft-ui-runner-playwright build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "statecraft-ui-core": "workspace:*",
    "statecraft-ui-runner-playwright": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
